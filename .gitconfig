[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Vvek-sudo
	email = contact.vivekdas@gmail.com

! =========================================================================

!  UNIVERSITY CAMPUS NETWORK - SAMPLE DEVICE CONFIGURATIONS

! =========================================================================



! -------------------------------------------------------------------------

! 1. Core Router (Building C / Main Gateway & DHCP Server)

! -------------------------------------------------------------------------

enable

configure terminal

hostname Core-Router



! Enable IP routing

ip routing



! Configure Interfaces

interface GigabitEthernet0/0/0

 description Link to Main Distribution Switch

 no shutdown

!

interface GigabitEthernet0/0/0.10

 encapsulation dot1Q 10

 ip address 192.168.10.1 255.255.255.0

 description Admin VLAN Gateway

!

interface GigabitEthernet0/0/0.20

 encapsulation dot1Q 20

 ip address 192.168.20.1 255.255.255.0

 description Business Faculty VLAN Gateway

!

interface GigabitEthernet0/0/0.30

 encapsulation dot1Q 30

 ip address 192.168.30.1 255.255.255.0

 description Engineering & Art VLAN Gateway



! Configure Router-Based DHCP Server for Building A & Departments

ip dhcp pool Admin-Pool

 network 192.168.10.0 255.255.255.0

 default-router 192.168.10.1

 dns-server 8.8.8.8

!

ip dhcp pool Business-Pool

 network 192.168.20.0 255.255.255.0

 default-router 192.168.20.1

 dns-server 8.8.8.8



! Configure RIPv2 Dynamic Routing

router rip

 version 2

 no auto-summary

 network 192.168.10.0

 network 192.168.20.0

 network 192.168.30.0



! Static route for External Cloud Email Server

ip route 203.0.113.0 255.255.255.0 Serial0/0/0



end

write memory





! -------------------------------------------------------------------------

! 2. Building A Access/Distribution Switch (VLAN & Port Security)

! -------------------------------------------------------------------------

enable

configure terminal

hostname Building-A-Switch



! Create VLANs

vlan 10

 name Administration

vlan 20

 name Business

vlan 30

 name Engineering-Art

vlan 40

 name Student-Labs



! Configure Trunk Port to Core Router

interface FastEthernet0/1

 switchport mode trunk

 switchport trunk allowed vlan 10,20,30,40



! Configure Access Ports with Port Security

interface range FastEthernet0/2 - 10

 switchport mode access

 switchport access vlan 10

 switchport port-security

 switchport port-security maximum 2

 switchport port-security violation restrict

 switchport port-security mac-address sticky



end

write memory